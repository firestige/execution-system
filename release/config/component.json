{
  "schemaVersion": "wsr.release-component@1.0.0",
  "repository": "firestige/wsr-execution",
  "releaseBranch": "main",
  "triggerBranch": "release/next",
  "assetMode": "npm-package",
  "acceptanceCommand": "pnpm release:check-coordinates && pnpm test:full && pnpm test:coverage && pnpm typecheck && pnpm build && pnpm check:generated && pnpm harness static && pnpm harness feasibility",
  "buildCommand": "pnpm release:artifacts",
  "verifyCommand": "pnpm release:verify",
  "publisherAdapter": "npm-package+github-release",
  "remoteInstallMode": "npm-clean-project",
  "stablePolicy": "qualified-candidate-exact-assets",
  "capabilities": ["github-release", "npm-package"]
}
