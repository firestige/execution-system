{
  "name": "wsr-dsh-intake",
  "version": "0.1.4",
  "type": "module",
  "main": "./src/plugin.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./lib/client.js",
    "./binding-repository": "./src/binding-repository.js",
    "./command": "./src/command.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "skills",
    "cordis.patch.yml",
    "README.zh-CN.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "compatibility": {
      "executionSystem": "0.1.4",
      "dsh": "0.1.1-rc.2",
      "agents": "0.1.1-rc.2",
      "commands": "0.1.1-rc.2",
      "skillFilesystem": "0.1.1-rc.2",
      "toolSkill": "0.1.1-rc.2",
      "tools": "0.1.1-rc.2"
    }
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "wsr-execution": "0.1.4"
  },
  "scripts": {
    "prepack": "node -e \"if(process.env.WSR_RELEASE_PACK_MODE!=='verified-builder')throw new Error('DIRECT_SOURCE_PACK_PROHIBITED')\"",
    "prepublishOnly": "node -e \"throw new Error('DIRECT_SOURCE_PUBLISH_PROHIBITED_USE_QUALIFIED_TGZ')\""
  },
  "description": "DSH plugin that brings version-bound workflows into your chat: /wsr commands, the workflow_execution_intake tool, Deliveries & Current status sidebar tabs, and isolated Runner-owned execution. · 在 DeepSeek Harness 对话中运行版本绑定、可审计的工作流：/wsr 命令、workflow_execution_intake 工具、Deliveries/Current 侧边栏，以及 Runner 隔离执行。",
  "keywords": [
    "wsr",
    "workflow-self-recursive",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "workflow",
    "agent",
    "intake",
    "command"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firestige/wsr-execution.git"
  },
  "homepage": "https://github.com/firestige/wsr-execution",
  "bugs": {
    "url": "https://github.com/firestige/wsr-execution/issues"
  },
  "author": {
    "name": "firestige"
  }
}
