{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agentops:workflow-dsl:1.1.0:artifacts",
  "title": "Agent Ops Artifact Template Catalog",
  "description": "Artifact template catalog document (agentops.artifacts): first-class output/intermediate Artifact templates with real content or a fixed reference, section coverage, completion conditions, lifecycle and dependency-validity rules.",
  "type": "object",
  "required": ["kind", "schemaVersion", "artifacts"],
  "properties": {
    "kind": { "const": "agentops.artifacts" },
    "schemaVersion": { "$ref": "urn:agentops:workflow-dsl:1.1.0:meta#/$defs/contractVersion" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "template", "lifecycle", "producedBy"],
        "properties": {
          "id": { "$ref": "urn:agentops:workflow-dsl:1.1.0:meta#/$defs/identity" },
          "name": { "type": "string" },
          "kind": { "enum": ["output", "intermediate"] },
          "template": {
            "oneOf": [
              {
                "type": "object",
                "required": ["content"],
                "properties": { "content": { "type": "string" } },
                "additionalProperties": false,
                "description": "Real template content; a name-only entry is never admissible (spec §6.7)."
              },
              {
                "type": "object",
                "required": ["reference"],
                "properties": { "reference": { "$ref": "urn:agentops:workflow-dsl:1.1.0:meta#/$defs/resourceRef" } },
                "additionalProperties": false,
                "description": "Fixed reference to a declared template resource with exact content identity."
              }
            ]
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["topic", "questions", "completionCondition"],
              "properties": {
                "topic": { "type": "string" },
                "questions": { "type": "array", "items": { "type": "string" } },
                "completionCondition": { "type": "string" },
                "naRule": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "lifecycle": {
            "type": "object",
            "required": ["states", "storageKind", "retentionClass"],
            "properties": {
              "states": { "type": "array", "items": { "type": "string" } },
              "storageKind": { "enum": ["RUN_WORKSPACE", "REPOSITORY_DELIVERABLE"] },
              "retentionClass": {
                "enum": ["ACTION_EPHEMERAL", "DELIVERY_RECOVERABLE", "TERMINAL_REFERENCE", "REPOSITORY_DELIVERABLE", "EXTERNAL_AUTHORITY"]
              }
            },
            "additionalProperties": false
          },
          "dependencyValidity": {
            "enum": ["CURRENT", "STALE_PENDING_IMPACT", "INVALIDATED", "REVALIDATED"]
          },
          "producedBy": { "$ref": "urn:agentops:workflow-dsl:1.1.0:meta#/$defs/identity" },
          "consumedBy": { "$ref": "urn:agentops:workflow-dsl:1.1.0:meta#/$defs/identityList" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
