{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agentops:workflow-dsl:1.1.0:meta",
  "title": "Agent Ops Workflow DSL — shared definitions",
  "description": "Shared closed definitions for agentops.workflow-dsl@2.0.0.",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contractVersion": {
      "type": "string",
      "const": "agentops.workflow-dsl@2.0.0"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "contentIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceLocator": {
      "type": "object",
      "required": [
        "repository",
        "path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "schemaRef": {
      "type": "object",
      "required": [
        "path",
        "contentIdentity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contentIdentity": {
          "$ref": "#/$defs/contentIdentity"
        }
      },
      "additionalProperties": false
    },
    "inlineSchema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/inlineSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/inlineSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "const": {}
      },
      "additionalProperties": false
    },
    "schemaOrInline": {
      "oneOf": [
        {
          "$ref": "#/$defs/schemaRef"
        },
        {
          "$ref": "#/$defs/inlineSchema"
        }
      ]
    },
    "resourceRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        }
      },
      "additionalProperties": false
    },
    "identityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identity"
      },
      "uniqueItems": true
    },
    "authorityOrder": {
      "type": "array",
      "const": [
        "workflow_action",
        "role_prompt",
        "action_prompt",
        "skill",
        "artifact_user"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9._-]{0,127}|terminal:[A-Za-z][A-Za-z0-9._-]{0,127})$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "valueSlot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "whole"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "property"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9_]*$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "executionSite": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "nodeIdentity"
          ],
          "properties": {
            "kind": {
              "const": "node"
            },
            "nodeIdentity": {
              "$ref": "#/$defs/identity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "nodeIdentity",
            "branchIdentity"
          ],
          "properties": {
            "kind": {
              "const": "parallel-branch"
            },
            "nodeIdentity": {
              "$ref": "#/$defs/identity"
            },
            "branchIdentity": {
              "$ref": "#/$defs/identity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "nodeIdentity"
          ],
          "properties": {
            "kind": {
              "const": "parallel-join"
            },
            "nodeIdentity": {
              "$ref": "#/$defs/identity"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sourcePort": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "enum": [
                "context",
                "state"
              ]
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "artifactIdentity"
          ],
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "artifactIdentity": {
              "$ref": "#/$defs/identity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "site",
            "slot"
          ],
          "properties": {
            "kind": {
              "const": "site-result"
            },
            "site": {
              "$ref": "#/$defs/executionSite"
            },
            "slot": {
              "$ref": "#/$defs/valueSlot"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "controlIdentity",
            "slot"
          ],
          "properties": {
            "kind": {
              "const": "control-result"
            },
            "controlIdentity": {
              "$ref": "#/$defs/identity"
            },
            "slot": {
              "$ref": "#/$defs/valueSlot"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "targetPort": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "site",
            "slot"
          ],
          "properties": {
            "kind": {
              "const": "site-input"
            },
            "site": {
              "$ref": "#/$defs/executionSite"
            },
            "slot": {
              "$ref": "#/$defs/valueSlot"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "controlIdentity",
            "slot"
          ],
          "properties": {
            "kind": {
              "const": "control-input"
            },
            "controlIdentity": {
              "$ref": "#/$defs/identity"
            },
            "slot": {
              "$ref": "#/$defs/valueSlot"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "state"
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "artifactIdentity"
          ],
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "artifactIdentity": {
              "$ref": "#/$defs/identity"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
