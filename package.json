{
  "name": "@workflow-self-recursive/execution-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./execution-runtime-adapter": {
      "types": "./dist/execution/runtime-adapter.d.ts",
      "default": "./dist/execution/runtime-adapter.js"
    }
  },
  "bin": {
    "execution-config": "./dist/configuration/cli.js"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "generate:contracts": "node --import tsx scripts/generate-workflow-contract.ts",
    "check:generated": "node --import tsx scripts/generate-workflow-contract.ts --check",
    "harness": "node --import tsx scripts/implementation-harness.ts",
    "test": "vitest run",
    "test:focused": "vitest run",
    "test:full": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "ajv": "8.20.0",
    "tar": "7.5.11",
    "yaml": "2.9.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
