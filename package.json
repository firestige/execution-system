{
  "name": "@workflow-self-recursive/execution-system",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./execution-runtime-adapter": {
      "types": "./dist/execution/runtime-adapter.d.ts",
      "default": "./dist/execution/runtime-adapter.js"
    }
  },
  "bin": {
    "execution-config": "./dist/configuration/cli.js"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "generate:contracts": "node --import tsx scripts/generate-workflow-contract.ts",
    "check:generated": "node --import tsx scripts/generate-workflow-contract.ts --check",
    "harness": "node --import tsx scripts/implementation-harness.ts",
    "test": "vitest run",
    "test:focused": "vitest run",
    "test:full": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "quickstart:prepare": "pnpm install --frozen-lockfile && node --import tsx scripts/prepare-local-e2e.ts",
    "release:artifacts": "node --import tsx scripts/build-release-artifacts.ts",
    "release:verify": "node --import tsx scripts/verify-release-artifacts.ts",
    "release:policy": "node --import tsx scripts/release-promotion-policy.ts",
    "qualify:dsh-interactive": "node --import tsx scripts/qualify-dsh-interactive-intake.ts",
    "release:workflow-assets": "node --import tsx scripts/build-workflow-release-assets.ts",
    "verify:iteration3-docs": "node --import tsx scripts/verify-iteration-3-documentation.ts . ..",
    "verify:dsh-intake": "node --import tsx scripts/verify-dsh-intake-distribution.ts",
    "qualify:dsh-package-lifecycle": "node --import tsx scripts/qualify-dsh-package-lifecycle.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/otlp-transformer": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "ajv": "8.20.0",
    "tar": "7.5.11",
    "yaml": "2.9.0",
    "zod": "4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
